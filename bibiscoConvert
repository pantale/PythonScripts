}

FORMAT_CHOICES = ["json", "markdown", "md", "latex", "tex"]


def normalize_output_format(value: str) -> str:
    value = value.lower().strip()
    if value not in FORMAT_ALIASES:
        raise argparse.ArgumentTypeError(
            "format invalide : choisir parmi json, markdown, md, latex, tex"
        )
    return FORMAT_ALIASES[value]


def format_completer(prefix, parsed_args, **kwargs):
    return [item for item in FORMAT_CHOICES if item.startswith(prefix)]


def apply_french_substitutions(text: str) -> str:
    if not text:
        return text

#    text = text.replace("---", "—")
#    text = text.replace("--", "–")
    text = re.sub(r'"([^"]*)"', rf"«{NBSP}\1{NBSP}»", text)
    text = text.replace("...", "…")

#    text = re.sub(r"\s*([:;!?])", rf"{NBSP}\1", text)

    text = re.sub(r"(\d{1,2})\s*h\s*(\d{2})", rf"\1{NBSP}h{NBSP}\2", text)

    return text


def apply_latex_substitutions(text: str) -> str:
    if not text:
        return text

    text = re.sub(r"(?m)^[ \t]*\*\*\*[ \t]*$", r"\\StarSeparator", text)

# Prise en compte d'une heure de type 09:17 sans espace devant le :
    text = re.sub(r"(?<!\d)(\d{1,2}):(\d{2})(?!\d)", r"{\\NoAutoSpacing \1:\2}", text)

    return text


def apply_substitutions(text: str, output_format: str = "json") -> str:
    if not text:
        return text

    text = apply_french_substitutions(text)
    if output_format == "latex":
        text = apply_latex_substitutions(text)
    return text


def apply_substitutions_to_object(obj: Any) -> Any:
    if isinstance(obj, str):
        return apply_french_substitutions(obj)
    if isinstance(obj, list):
        return [apply_substitutions_to_object(item) for item in obj]
    if isinstance(obj, dict):
        return {key: apply_substitutions_to_object(value) for key, value in obj.items()}
    return obj


def latex_escape(text: str) -> str:
    replacements = {
        "\\": r"\textbackslash{}",
        "&": r"\&",
        "%": r"\%",
        "$": r"\$",
        "#": r"\#",
        "_": r"\_",
        "{": r"\{",
        "}": r"\}",
        "~": r"\textasciitilde{}",
        "^": r"\textasciicircum{}",
    }
    return "".join(replacements.get(ch, ch) for ch in text)


def split_paragraph_into_sentences(text: str) -> List[str]:
    text = re.sub(r"[ \t\r\f\v]+", " ", text.strip(" \t\r\f\v\n"))
    if not text:
        return []

    sentences: List[str] = []
    current: List[str] = []

    inside_french_quotes = False
    inside_straight_quotes = False

    i = 0
    n = len(text)

    while i < n:
        ch = text[i]
        current.append(ch)

        if ch == "«":
            inside_french_quotes = True
        elif ch == "»":
            inside_french_quotes = False
        elif ch == '"':
            inside_straight_quotes = not inside_straight_quotes
        elif ch in ".!?…" and not inside_french_quotes and not inside_straight_quotes:
            j = i + 1
            while j < n and text[j] in ".!?…":
                current.append(text[j])
                j += 1

            sentence = "".join(current).strip(" \t\r\f\v\n")
            if sentence:
                sentences.append(sentence)

            current = []

            while j < n and text[j] in " \t\r\f\v\n":
                j += 1

            i = j
            continue

        i += 1

    tail = "".join(current).strip(" \t\r\f\v\n")
    if tail:
        sentences.append(tail)

    return sentences


def render_split_lines(text: str, output_format: str, split_lines: bool = False) -> str:
    if not split_lines or not text:
        return text

    paragraphs = text.split("\n")
    rendered_paragraphs: List[str] = []

    for paragraph in paragraphs:
        paragraph = paragraph.strip()

        if not paragraph:
            rendered_paragraphs.append("")
            continue

        sentences = split_paragraph_into_sentences(paragraph)
        rendered_paragraphs.append("\n".join(sentences))

    return "\n".join(rendered_paragraphs)


def transform_latex_command_paragraph(text: str, final_mode: bool = False) -> str:
    if not text:
        return text

    first_line, sep, rest = text.partition("\n")
    match = re.match(r"^@([^\s:]+):(.*)$", first_line)

    if not match:
        return text

    if final_mode:
        return rest if sep else ""

    command_label = latex_escape(f"@{match.group(1)}:")
    first_line_remainder = match.group(2).lstrip()

    rendered_first_line = rf"\textcolor{{red}}{{\textbf{{{command_label}}}}}"
    if first_line_remainder:
        rendered_first_line += rf" \emph{{{first_line_remainder}}}"

    if sep:
        return rendered_first_line + "\n" + rest

    return rendered_first_line


def render_latex_block(text: str, split_lines: bool = False, final_mode: bool = False) -> str:
    if not text:
        return text

    text = transform_latex_command_paragraph(text, final_mode=final_mode)
    if not text.strip():
        return ""

    return render_split_lines(text, "latex", split_lines)


class RichTextBlockExtractor(HTMLParser):
    def __init__(self, output_format: str = "json", subs: bool = False):
        super().__init__(convert_charrefs=False)
        self.output_format = output_format
        self.subs = subs
        self.in_paragraph = False
        self.current_parts: List[str] = []
        self.blocks: List[str] = []
        self.tag_stack: List[str] = []

    def handle_starttag(self, tag: str, attrs):
        tag = tag.lower()

        if tag == "p":
            self.in_paragraph = True
            self.current_parts = []
            return

        if not self.in_paragraph:
            return

        if tag in {"b", "strong", "i", "em", "u", "sup"}:
            self.tag_stack.append(tag)
            self.current_parts.append(self._open_marker(tag))
        elif tag == "br":
            self.current_parts.append("\n")

    def handle_endtag(self, tag: str):
        tag = tag.lower()

        if tag == "p":
            if self.in_paragraph:
                self.close_open_tags()
                text = "".join(self.current_parts)
                text = self._normalize(text)
                if text:
                    self.blocks.append(text)
                self.current_parts = []
                self.in_paragraph = False
            return

        if not self.in_paragraph:
            return

        if tag in {"b", "strong", "i", "em", "u", "sup"}:
            self.current_parts.append(self._close_marker(tag))
            for idx in range(len(self.tag_stack) - 1, -1, -1):
                if self.tag_stack[idx] == tag:
                    del self.tag_stack[idx]
                    break

    def handle_data(self, data: str):
        if not self.in_paragraph:
            return

        data = unescape(data)
        if self.output_format == "latex":
            data = latex_escape(data)
        self.current_parts.append(data)

    def handle_entityref(self, name: str):
        if self.in_paragraph:
            self.handle_data(unescape(f"&{name};"))

    def handle_charref(self, name: str):
        if self.in_paragraph:
            self.handle_data(unescape(f"&#{name};"))

    def close_open_tags(self):
        while self.tag_stack:
            tag = self.tag_stack.pop()
            self.current_parts.append(self._close_marker(tag))

    def _open_marker(self, tag: str) -> str:
        if self.output_format == "markdown":
            if tag in {"b", "strong"}:
                return "**"
            if tag in {"i", "em"}:
                return "*"
            if tag == "u":
                return ""
            if tag == "sup":
                return "<sup>"

        elif self.output_format == "latex":
            if tag in {"b", "strong"}:
                return r"\textbf{"
            if tag in {"i", "em"}:
                return r"\emph{"
            if tag == "u":
                return r"\underline{"
            if tag == "sup":
                return r"\textsuperscript{"

        return ""

    def _close_marker(self, tag: str) -> str:
        if self.output_format == "markdown":
            if tag in {"b", "strong"}:
                return "**"
            if tag in {"i", "em"}:
                return "*"
            if tag == "u":
                return ""
            if tag == "sup":
                return "</sup>"

        elif self.output_format == "latex":
            if tag in {"b", "strong", "i", "em", "u", "sup"}:
                return "}"

        return ""

    def _normalize(self, text: str) -> str:
        text = re.sub(r"[ \t\r\f\v]+", " ", text)
        text = re.sub(r"[ \t\r\f\v]*\n[ \t\r\f\v]*", "\n", text)
        text = re.sub(r"\n{3,}", "\n\n", text)
        text = text.strip(" \t\r\f\v\n")
        if self.subs:
            text = apply_substitutions(text, self.output_format)
        return text


def extract_blocks(html_fragment: str, output_format: str = "json", subs: bool = False) -> List[str]:
    if not html_fragment:
        return []

    parser = RichTextBlockExtractor(output_format=output_format, subs=subs)
    parser.feed(html_fragment)
    parser.close()

    if parser.blocks:
        return parser.blocks

    text = unescape(re.sub(r"<[^>]+>", "", html_fragment)).strip()
    if output_format == "latex":
        text = latex_escape(text)
    if subs:
        text = apply_substitutions(text, output_format)
    return [text] if text else []


def html_to_text(html_fragment: str, output_format: str = "json", subs: bool = False) -> str:
    blocks = extract_blocks(html_fragment, output_format=output_format, subs=subs)
    return "\n\n".join(blocks)


def slugify(value: str) -> str:
    value = unescape(value).strip().lower()
    value = unicodedata.normalize("NFKD", value)
    value = value.encode("ascii", "ignore").decode("ascii")
    value = re.sub(r"[^\w\s-]", "", value, flags=re.UNICODE)
    value = re.sub(r"[-\s]+", "-", value, flags=re.UNICODE)
    return value.strip("-") or "chapitre"


def strip_markup(text: str) -> str:
    text = re.sub(r"</?(strong|em|u)>", "", text)
    text = re.sub(r"[*_`#>-]", "", text)
    text = re.sub(r"\s+", " ", text)
    return text.strip()


def get_collection(data: Dict[str, Any], name: str) -> List[Dict[str, Any]]:
    for collection in data.get("collections", []):
        if collection.get("name") == name:
            return collection.get("data", [])
    return []


def get_current_revision(scene: Dict[str, Any]) -> Dict[str, Any]:
    revisions = scene.get("revisions", [])
    revision_index = scene.get("revision", 0)
    if 0 <= revision_index < len(revisions):
        return revisions[revision_index]
    return {}


def is_done(status: Any) -> bool:
    return str(status).strip().lower() == DONE_STATUS


def filter_done_structure(data: List[Dict[str, Any]]) -> List[Dict[str, Any]]:
    filtered: List[Dict[str, Any]] = []

    for chapter in data:
        if not is_done(chapter.get("chapter_status")):
            continue

        scenes = [
            scene
            for scene in chapter.get("scenes", [])
            if is_done(scene.get("scene_status"))
        ]

        if not scenes:
            continue

        chapter_copy = copy.deepcopy(chapter)
        chapter_copy["scenes"] = scenes
        chapter_copy["chapter_words"] = sum(scene.get("words", 0) for scene in scenes)
        chapter_copy["chapter_characters"] = sum(scene.get("characters", 0) for scene in scenes)

        filtered.append(chapter_copy)

    return filtered


def select_single_chapter(data: List[Dict[str, Any]], chapter_number: int) -> List[Dict[str, Any]]:
    if chapter_number < 1 or chapter_number > len(data):
        raise ValueError(
            f"numéro de chapitre invalide : {chapter_number} "
            f"(valeurs possibles : 1 à {len(data)})"
        )
    return [data[chapter_number - 1]]


def build_structure(
    data: Dict[str, Any],
    output_format: str = "json",
    include_text: bool = False,
    subs: bool = False,
) -> List[Dict[str, Any]]:
    chapters = sorted(get_collection(data, "chapters"), key=lambda c: c.get("position", 0))
    scenes = sorted(
        get_collection(data, "scenes"),
        key=lambda s: (s.get("chapterid", 0), s.get("position", 0)),
    )

    chapter_map: Dict[Any, Dict[str, Any]] = {}
    output: List[Dict[str, Any]] = []

    for chapter in chapters:
        chapter_id = chapter.get("$loki")
        chapter_entry = {
            "chapter_id": chapter_id,
            "chapter_title": chapter.get("title", ""),
            "chapter_position": chapter.get("position"),
            "chapter_status": chapter.get("status"),
            "chapter_words": chapter.get("words", 0),
            "chapter_characters": chapter.get("characters", 0),
            "scenes": [],
        }
        chapter_map[chapter_id] = chapter_entry
        output.append(chapter_entry)

    for scene in scenes:
        revision = get_current_revision(scene)
        blocks = extract_blocks(
            revision.get("text", ""),
            output_format=output_format,
            subs=subs,
        )

        scene_entry = {
            "scene_id": scene.get("$loki"),
            "scene_title": scene.get("title", ""),
            "scene_position": scene.get("position"),
            "scene_status": scene.get("status"),
            "words": revision.get("words", scene.get("words", 0)),
            "characters": revision.get("characters", scene.get("characters", 0)),
            "blocks": blocks,
        }

        if include_text:
            scene_entry["text"] = "\n\n".join(blocks)

        chapter_id = scene.get("chapterid")
        if chapter_id not in chapter_map:
            orphan = {
                "chapter_id": chapter_id,
                "chapter_title": f"Chapitre inconnu {chapter_id}",
                "chapter_position": None,
                "chapter_status": None,
                "chapter_words": 0,
                "chapter_characters": 0,
                "scenes": [],
            }
            chapter_map[chapter_id] = orphan
            output.append(orphan)

        chapter_map[chapter_id]["scenes"].append(scene_entry)

    return output


def build_character_export(
    data: Dict[str, Any],
    output_format: str = "json",
    subs: bool = False,
) -> Dict[str, Any]:
    main_characters = sorted(get_collection(data, "maincharacters"), key=lambda c: c.get("position", 0))
    secondary_characters = sorted(get_collection(data, "secondarycharacters"), key=lambda c: c.get("position", 0))

    def convert_character(character: Dict[str, Any], category: str) -> Dict[str, Any]:
        return {
            "id": character.get("$loki"),
            "category": category,
            "position": character.get("position"),
            "status": character.get("status"),
            "name": character.get("name", ""),
            "description": html_to_text(
                character.get("description", ""),
                output_format=output_format,
                subs=subs,
            ),
            "notes": html_to_text(
                character.get("notes", {}).get("text", ""),
                output_format=output_format,
                subs=subs,
            ),
            "conflict": html_to_text(
                character.get("conflict", {}).get("text", ""),
                output_format=output_format,
                subs=subs,
            ),
            "evolution": html_to_text(
                character.get("evolutionduringthestory", {}).get("text", ""),
                output_format=output_format,
                subs=subs,
            ),
            "life_before_story": html_to_text(
                character.get("lifebeforestorybeginning", {}).get("text", ""),
                output_format=output_format,
                subs=subs,
            ),
            "images": [img.get("filename") for img in character.get("images", []) if img.get("filename")],
        }

    characters = [convert_character(c, "main") for c in main_characters]
    characters.extend(convert_character(c, "secondary") for c in secondary_characters)

    return {
        "count": len(characters),
        "main_count": len(main_characters),
        "secondary_count": len(secondary_characters),
        "characters": characters,
    }


def build_location_export(
    data: Dict[str, Any],
    output_format: str = "json",
    subs: bool = False,
) -> Dict[str, Any]:
    locations = sorted(get_collection(data, "locations"), key=lambda c: c.get("position", 0))

    location_items = []
    for location in locations:
        location_items.append(
            {
                "id": location.get("$loki"),
                "position": location.get("position"),
                "status": location.get("status"),
                "location": location.get("location", ""),
                "city": location.get("city", ""),
                "state": location.get("state", ""),
                "nation": location.get("nation", ""),
                "description": html_to_text(
                    location.get("description", ""),
                    output_format=output_format,
                    subs=subs,
                ),
                "images": [img.get("filename") for img in location.get("images", []) if img.get("filename")],
            }
        )

    return {
        "count": len(location_items),
        "locations": location_items,
    }


def scene_to_markdown(
    scene: Dict[str, Any],
    include_scene_header: bool = False,
    split_lines: bool = False,
) -> List[str]:
    lines: List[str] = []
    if include_scene_header:
        lines.extend([f"## {scene['scene_title']}", ""])
    for block in scene.get("blocks", []):
        lines.extend([render_split_lines(block, "markdown", split_lines), ""])
    return lines


def to_markdown(
    data: List[Dict[str, Any]],
    include_scene_headers: bool = False,
    split_lines: bool = False,
) -> str:
    lines: List[str] = []
    for chapter in data:
        lines.extend([f"# {chapter['chapter_title']}", ""])
        for scene in chapter.get("scenes", []):
            lines.extend(
                scene_to_markdown(
                    scene,
                    include_scene_header=include_scene_headers,
                    split_lines=split_lines,
                )
            )
    return "\n".join(lines).rstrip() + "\n"


def scene_to_latex(
    scene: Dict[str, Any],
    include_scene_header: bool = False,
    split_lines: bool = False,
    final_mode: bool = False,
) -> List[str]:
    lines: List[str] = []
    if include_scene_header:
        lines.extend([rf"\section{{{latex_escape(scene['scene_title'])}}}", ""])

    for block in scene.get("blocks", []):
        rendered_block = render_latex_block(
            block,
            split_lines=split_lines,
            final_mode=final_mode,
        )
        if rendered_block:
            lines.extend([rendered_block, ""])

    return lines


def latex_document(body: str, title: str = "Export Bibisco") -> str:
    return (
        "\\documentclass[11pt,a4paper]{book}\n"
        "\\usepackage[T1]{fontenc}\n"
        "\\usepackage[utf8]{inputenc}\n"
        "\\usepackage[french]{babel}\n"
        "\\usepackage[a4paper,margin=2.5cm]{geometry}\n"
        "\\usepackage{xcolor}\n"
        "\\usepackage{hyperref}\n"
        "\\title{" + latex_escape(title) + "}\n"
        "\\date{}\n"
        "\\begin{document}\n"
        "\\maketitle\n\n"
        + body
        + "\n\\end{document}\n"
    )


def to_latex(
    data: List[Dict[str, Any]],
    include_scene_headers: bool = False,
    full_document: bool = False,
    title: str = "Export Bibisco",
    split_lines: bool = False,
    final_mode: bool = False,
) -> str:
    lines: List[str] = []
    for fallback_number, chapter in enumerate(data, start=1):
        position = chapter.get("chapter_position")
        chapter_number = position + 1 if isinstance(position, int) and position >= 0 else fallback_number
        lines.extend([
            "% !TeX spellcheck = fr_FR",
            "% !TeX root = Book.tex",
            "%",
            f"% LaTeX source file of Chapter {chapter_number:02d}",
            "%",
            "% (c) by Olivier Pantalé 2026",
            "%",
            rf"\chapter{{{latex_escape(chapter['chapter_title'])}}}",
            "",
        ])
        for scene in chapter.get("scenes", []):
            lines.extend(
                scene_to_latex(
                    scene,
                    include_scene_header=include_scene_headers,
                    split_lines=split_lines,
                    final_mode=final_mode,
                )
            )

    body = "\n".join(lines).rstrip() + "\n"
    return latex_document(body, title=title) if full_document else body


def characters_to_markdown(data: Dict[str, Any], split_lines: bool = False) -> str:
    lines: List[str] = ["# Personnages", ""]

    if data.get("main_count", 0):
        lines.extend(["## Personnages principaux", ""])
    for item in data["characters"]:
        if item["category"] != "main":
            continue
        lines.extend([f"### {item['name']}", ""])
        if item.get("description"):
            lines.extend([render_split_lines(item["description"], "markdown", split_lines), ""])
        if item.get("notes"):
            lines.extend(["#### Notes", "", render_split_lines(item["notes"], "markdown", split_lines), ""])
        if item.get("conflict"):
            lines.extend(["#### Conflit", "", render_split_lines(item["conflict"], "markdown", split_lines), ""])
        if item.get("evolution"):
            lines.extend(["#### Évolution", "", render_split_lines(item["evolution"], "markdown", split_lines), ""])
        if item.get("life_before_story"):
            lines.extend([
                "#### Vie avant le récit",
                "",
                render_split_lines(item["life_before_story"], "markdown", split_lines),
                "",
            ])

    if data.get("secondary_count", 0):
        lines.extend(["## Personnages secondaires", ""])
    for item in data["characters"]:
        if item["category"] != "secondary":
            continue
        lines.extend([f"### {item['name']}", ""])
        if item.get("description"):
            lines.extend([render_split_lines(item["description"], "markdown", split_lines), ""])

    return "\n".join(lines).rstrip() + "\n"


