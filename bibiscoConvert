    total_words = sum(scene.get("words", 0) for chapter in structured for scene in chapter.get("scenes", []))
    total_characters = sum(scene.get("characters", 0) for chapter in structured for scene in chapter.get("scenes", []))

    print("Structure du roman")
    print("------------------")
    if project_info:
        print(f"Titre : {project_info.get('name', '')}")
        print(f"Auteur : {project_info.get('author', '')}")
        print(f"Langue : {project_info.get('language', '')}")
    print(f"Chapitres : {total_chapters}")
    print(f"Scènes : {total_scenes}")
    print(f"Blocs : {total_blocks}")
    print(f"Mots : {total_words}")
    print(f"Caractères : {total_characters}")
    print()

    for idx, chapter in enumerate(structured, start=1):
        chapter_words = sum(scene.get("words", 0) for scene in chapter.get("scenes", []))
        chapter_characters = sum(scene.get("characters", 0) for scene in chapter.get("scenes", []))
        chapter_blocks = sum(len(scene.get("blocks", [])) for scene in chapter.get("scenes", []))

        print(f"{idx:02d}. {chapter['chapter_title']}")
        print(
            f"    position={chapter.get('chapter_position')} | scènes={len(chapter.get('scenes', []))} | "
            f"blocs={chapter_blocks} | mots={chapter_words} | caractères={chapter_characters}"
        )

        for jdx, scene in enumerate(chapter.get("scenes", []), start=1):
            preview = strip_markup(scene["blocks"][0]) if scene.get("blocks") else ""
            if len(preview) > 90:
                preview = preview[:87] + "..."

            print(
                f"    {idx:02d}.{jdx:02d} {scene['scene_title']} | position={scene.get('scene_position')} | "
                f"statut={scene.get('scene_status')} | blocs={len(scene.get('blocks', []))} | "
                f"mots={scene.get('words', 0)} | caractères={scene.get('characters', 0)}"
            )

            if preview:
                print(f"         extrait : {preview}")
        print()

    character_export = build_character_export(data)
    location_export = build_location_export(data)
    print(f"Personnages principaux : {character_export['main_count']}")
    print(f"Personnages secondaires : {character_export['secondary_count']}")
    print(f"Lieux : {location_export['count']}")


def default_output_path(
    input_path: Path,
    output_format: str,
    separate_chapters: bool,
    kind: str = "scenes",
) -> Path:
    ext_map = {"json": ".json", "markdown": ".md", "latex": ".tex"}

    if kind == "characters":
        return input_path.with_name(f"{input_path.stem}_characters{ext_map[output_format]}")
    if kind == "locations":
        return input_path.with_name(f"{input_path.stem}_locations{ext_map[output_format]}")
    if separate_chapters:
        suffix = "chapters_md" if output_format == "markdown" else "chapters_tex"
        return input_path.with_name(f"{input_path.stem}_{suffix}")
    return input_path.with_name(f"{input_path.stem}_scenes{ext_map[output_format]}")


def validate_args(args: argparse.Namespace, parser: argparse.ArgumentParser) -> None:
    fmt = args.format

    if args.json_full and fmt != "json":
        parser.error("l'option --json-full nécessite --format json")

    if args.latex_full and fmt != "latex":
        parser.error("l'option --latex-full nécessite --format latex")

    if args.scenes and fmt not in {"markdown", "latex"}:
        parser.error("l'option --scenes nécessite --format markdown ou --format latex")

    if args.split_lines and fmt not in {"markdown", "latex"}:
        parser.error("l'option --split-lines nécessite --format markdown ou --format latex")

    if args.separate_chapters and fmt not in {"markdown", "latex"}:
        parser.error("l'option --separate-chapters nécessite --format markdown ou --format latex")

    if args.separate_chapters and (args.export_characters or args.export_locations):
        parser.error("l'option --separate-chapters n'est valable que pour l'export des scènes")

    if args.export_characters and args.export_locations:
        parser.error("choisir soit --export-characters soit --export-locations")


def build_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(
        prog=PROGRAM_NAME,
        description="Extrait et exporte un projet Bibisco en JSON, Markdown ou LaTeX.",
        epilog=(
            f"Version : {PROGRAM_VERSION}\n"
            f"{PROGRAM_COPYRIGHT}\n\n"
            "Exemples :\n"
            f"  {PROGRAM_NAME} projet.json\n"
            f"  {PROGRAM_NAME} projet.json --display\n"
            f"  {PROGRAM_NAME} projet.json --format json --json-full\n"
            f"  {PROGRAM_NAME} projet.json --format markdown -o roman.md\n"
            f"  {PROGRAM_NAME} projet.json --format markdown --scenes -o roman-scenes.md\n"
            f"  {PROGRAM_NAME} projet.json --format markdown --split-lines -o roman-lignes.md\n"
            f"  {PROGRAM_NAME} projet.json --format markdown --separate-chapters -o chapitres_md\n"
            f"  {PROGRAM_NAME} projet.json --format latex -o roman.tex\n"
            f"  {PROGRAM_NAME} projet.json --format latex --latex-full -o roman-complet.tex\n"
            f"  {PROGRAM_NAME} projet.json --format latex --scenes --split-lines -o roman-lignes.tex\n"
            f"  {PROGRAM_NAME} projet.json --format latex --scenes --separate-chapters -o chapitres_tex\n"
            f"  {PROGRAM_NAME} projet.json --format markdown --subs -o roman-subs.md\n"
            f"  {PROGRAM_NAME} projet.json --export-characters --format json -o personnages.json\n"
            f"  {PROGRAM_NAME} projet.json --export-locations --format latex -o lieux.tex\n"
            f"  {PROGRAM_NAME} --version"
        ),
        formatter_class=argparse.RawTextHelpFormatter,
    )

    parser.add_argument("input", type=Path, help="Fichier JSON Bibisco en entrée")
    parser.add_argument("output_positional", nargs="?", type=Path, help=argparse.SUPPRESS)

    parser.add_argument(
        "-o",
        "--output",
        dest="output_option",
        type=Path,
        help="Nom du fichier ou du répertoire de sortie",
    )

    format_arg = parser.add_argument(
        "--format",
        type=normalize_output_format,
        default="json",
        help="Format de sortie : json, markdown/md, latex/tex (défaut : json)",
    )
    if argcomplete is not None:
        format_arg.completer = format_completer

    parser.add_argument(
        "--subs",
        action="store_true",
        help="Applique les substitutions typographiques de type substituteFrench-2",
    )

    parser.add_argument(
        "--display",
        action="store_true",
        help="Affiche la structure du roman et les statistiques principales",
    )

    parser.add_argument(
        "--json-full",
        action="store_true",
        help="En JSON, ajoute le champ text concaténé pour chaque scène",
    )

    parser.add_argument(
        "--latex-full",
        action="store_true",
        help="En LaTeX, génère un document complet compilable avec préambule minimal",
    )

    parser.add_argument(
        "--scenes",
        action="store_true",
        help="En Markdown/LaTeX, ajoute les noms des scènes comme sous-titres",
    )

    parser.add_argument(
        "--split-lines",
        action="store_true",
        help=(
            "En Markdown/LaTeX, écrit chaque phrase d'un paragraphe sur sa propre ligne, "
            "en coupant uniquement sur la ponctuation de fin de phrase"
        ),
    )

    parser.add_argument(
        "--separate-chapters",
        action="store_true",
        help="En Markdown/LaTeX, génère un fichier distinct par chapitre",
    )

    parser.add_argument(
        "--export-characters",
        dest="export_characters",
        action="store_true",
        help="Exporte les personnages du projet",
    )

    parser.add_argument(
        "--export-locations",
        dest="export_locations",
        action="store_true",
        help="Exporte les lieux du projet",
    )

    parser.add_argument(
        "--version",
        action="version",
        version=f"%(prog)s {PROGRAM_VERSION}",
        help="Affiche la version du programme et quitte",
    )

    return parser


def parse_args() -> argparse.Namespace:
    parser = build_parser()
    if argcomplete is not None:
        argcomplete.autocomplete(parser)

    args = parser.parse_args()
    args.output = args.output_option or args.output_positional
    validate_args(args, parser)
    return args


def main() -> int:
    print(PROGRAM_NAME)
    print(f"Version {PROGRAM_VERSION}")
    print(PROGRAM_COPYRIGHT)
    print()

    args = parse_args()

    try:
        with args.input.open("r", encoding="utf-8") as f:
            data = json.load(f)
    except FileNotFoundError:
        print(f"Erreur : fichier introuvable : {args.input}", file=sys.stderr)
        return 1
    except json.JSONDecodeError as exc:
        print(f"Erreur : JSON invalide : {exc}", file=sys.stderr)
        return 1

    fmt = args.format
    text_format = fmt if fmt in {"markdown", "latex"} else "json"

    if args.export_characters:
        export = build_character_export(
            data,
            output_format=text_format,
            subs=args.subs,
        )
        output_path = args.output if args.output else default_output_path(args.input, fmt, False, kind="characters")

        if fmt == "json":
            payload = apply_substitutions_to_object(export) if args.subs else export
            output_path.write_text(json.dumps(payload, ensure_ascii=False, indent=2) + "\n", encoding="utf-8")
        elif fmt == "markdown":
            content = characters_to_markdown(export, split_lines=args.split_lines)
            if args.subs:
                content = apply_french_substitutions(content)
            output_path.write_text(content, encoding="utf-8")
        else:
            content = characters_to_latex(
                export,
                full_document=args.latex_full,
                split_lines=args.split_lines,
            )
            if args.subs:
                content = apply_french_substitutions(content)
            output_path.write_text(content, encoding="utf-8")

        print(output_path)
        return 0

    if args.export_locations:
        export = build_location_export(
            data,
            output_format=text_format,
            subs=args.subs,
        )
        output_path = args.output if args.output else default_output_path(args.input, fmt, False, kind="locations")

        if fmt == "json":
            payload = apply_substitutions_to_object(export) if args.subs else export
            output_path.write_text(json.dumps(payload, ensure_ascii=False, indent=2) + "\n", encoding="utf-8")
        elif fmt == "markdown":
            content = locations_to_markdown(export, split_lines=args.split_lines)
            if args.subs:
                content = apply_french_substitutions(content)
            output_path.write_text(content, encoding="utf-8")
        else:
            content = locations_to_latex(
                export,
                full_document=args.latex_full,
                split_lines=args.split_lines,
            )
            if args.subs:
                content = apply_french_substitutions(content)
            output_path.write_text(content, encoding="utf-8")

        print(output_path)
        return 0

    structured = build_structure(
        data,
        output_format=text_format,
        include_text=args.json_full,
        subs=args.subs,
    )

    if args.display:
        display_structure(data, structured)
        if not args.output and fmt == "json" and not args.json_full and not args.separate_chapters:
            return 0

    output_path = args.output if args.output else default_output_path(args.input, fmt, args.separate_chapters)

    if args.separate_chapters:
        written_files = write_separate_chapter_files(
            structured,
            output_path,
            output_format=fmt,
            include_scene_headers=args.scenes,
            latex_full=args.latex_full,
            split_lines=args.split_lines,
        )
        for path in written_files:
            print(path)
        return 0

    if fmt == "json":
        payload = apply_substitutions_to_object(structured) if args.subs else structured
        output_path.write_text(json.dumps(payload, ensure_ascii=False, indent=2) + "\n", encoding="utf-8")

    elif fmt == "markdown":
        content = to_markdown(
            structured,
            include_scene_headers=args.scenes,
            split_lines=args.split_lines,
        )
        if args.subs:
            content = apply_french_substitutions(content)
        output_path.write_text(content, encoding="utf-8")

    else:
        project = get_collection(data, "project")
        title = project[0].get("name", "Export Bibisco") if project else "Export Bibisco"
        content = to_latex(
            structured,
            include_scene_headers=args.scenes,
            full_document=args.latex_full,
            title=title,
            split_lines=args.split_lines,
        )
        if args.subs:
            content = apply_french_substitutions(content)
        output_path.write_text(content, encoding="utf-8")

    print(output_path)
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
