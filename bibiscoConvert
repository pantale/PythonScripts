def write_separate_chapter_files(
    data: List[Dict[str, Any]],
    output_dir: Path,
    output_format: str,
    include_scene_headers: bool = False,
    latex_full: bool = False,
    split_lines: bool = False,
) -> List[Path]:
    output_dir.mkdir(parents=True, exist_ok=True)
    written_files: List[Path] = []

    ext = ".md" if output_format == "markdown" else ".tex"

    for index, chapter in enumerate(data, start=1):
        slug = slugify(chapter["chapter_title"])
        filename = f"{index:02d}-{slug}{ext}"
        path = output_dir / filename

        chapter_payload = [chapter]

        if output_format == "markdown":
            content = to_markdown(
                chapter_payload,
                include_scene_headers=include_scene_headers,
                split_lines=split_lines,
            )
        else:
            content = to_latex(
                chapter_payload,
                include_scene_headers=include_scene_headers,
                full_document=latex_full,
                title=chapter["chapter_title"],
                split_lines=split_lines,
            )

        path.write_text(content, encoding="utf-8")
        written_files.append(path)

    index_path = output_dir / "index.json"
    index_payload = [
        {
            "chapter_id": chapter["chapter_id"],
            "chapter_title": chapter["chapter_title"],
            "file": path.name,
        }
        for chapter, path in zip(data, written_files)
    ]
    index_path.write_text(json.dumps(index_payload, ensure_ascii=False, indent=2) + "\n", encoding="utf-8")
    written_files.append(index_path)

    return written_files


