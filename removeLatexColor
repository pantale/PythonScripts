def BackupFile(file):
    print('Backup file '+file+'to'+file+'.bak')
    shutil.copyfile(file, file+'.bak')

def removeBracket(aft):
    lv = 0
    ch = 0
    for c in aft:
        if c=='{': lv+=1
        if c=='}': lv-=1
        if (lv == 0): break
        ch += 1
    return aft[1:ch] + aft[ch+1:]

def readFile(filename):
    f = open(filename, 'r')
    filedata = f.read()
    f.close()
    return filedata

def writeFile(filename, text):
    f = open(filename, 'w')
    f.write(text)
    f.close()
    
def removeTextColor(centerTxt, color):
    se = '\\textcolor{'+color+'}'
    sl = len(se)
    while se in centerTxt:
        st = centerTxt.find(se)
        bef = centerTxt[:st]
        aft = removeBracket(centerTxt[st+sl:])
        centerTxt = bef + aft
    return centerTxt

