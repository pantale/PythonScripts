#!/usr/bin/env python3
import os
import sys
import glob
import shutil
import argparse

def replace_string_in_files(file_pattern, search_string, replace_string, backup=False, recursive=False):
    # Convert special characters in the search and replace strings
    search_string = search_string.encode().decode('unicode_escape')
    replace_string = replace_string.encode().decode('unicode_escape')

    # Find files matching the pattern in the current directory and its subdirectories
    if recursive:
        files = [os.path.join(root, f) for root, _, files in os.walk('.') for f in files if glob.fnmatch.fnmatch(f, file_pattern)]
    else:
        files = [f for f in os.listdir('.') if glob.fnmatch.fnmatch(f, file_pattern)]

    for file in files:
        # Read the contents of the file
        with open(file, 'r') as f:
            content = f.read()

        # Replace the string
        new_content = content.replace(search_string, replace_string)

        # Create a backup if requested
        if backup:
            backup_file = f"{os.path.splitext(file)[0]}-backup{os.path.splitext(file)[1]}"
            shutil.copy2(file, backup_file)

        # Write the new content to the file
        with open(file, 'w') as f:
            f.write(new_content)

        print(f"Processing file: {file}")

def display_usage():
    print("Usage: replaceInFile <file_pattern> <search_string> <replace_string> [-b|--backup] [-r|--recursive]")
    print("Description: Replace a string in files.")
    print("Arguments:")
    print("  <file_pattern>    The pattern to select the files to process")
    print("  <search_string>   The string to search for")
    print("  <replace_string>  The string to replace with")
    print("Options:")
    print("  -b, --backup      Create a backup of the files before replacing")
    print("  -r, --recursive   Apply the replacement recursively in subdirectories")

if __name__ == "__main__":
    print ("replaceInFile")
    print ("(c) by Olivier Pantalé 2024")
    print ("")
    parser = argparse.ArgumentParser(description='Replace a string in files.', usage=argparse.SUPPRESS)
    parser.add_argument('file_pattern', nargs='?', help='The pattern to select the files to process')
    parser.add_argument('search_string', nargs='?', help='The string to search for')
    parser.add_argument('replace_string', nargs='?', help='The string to replace with')
    parser.add_argument('-b', '--backup', action='store_true', help='Create a backup of the files before replacing')
    parser.add_argument('-r', '--recursive', action='store_true', help='Apply the replacement recursively in subdirectories')

    args = parser.parse_args()

    if not all([args.file_pattern, args.search_string, args.replace_string]):
        display_usage()
        sys.exit(1)

    replace_string_in_files(args.file_pattern, args.search_string, args.replace_string, args.backup, args.recursive)
 
