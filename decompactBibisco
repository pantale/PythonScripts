#!/usr/bin/env python3
# PYTHON_ARGCOMPLETE_OK
# -*- coding: utf-8 -*-

import argparse
import json
from pathlib import Path

import argcomplete
from argcomplete.completers import FilesCompleter


def build_parser():
    parser = argparse.ArgumentParser(
        description="Réécrit un fichier JSON en format lisible ou compact."
    )

    file_arg = parser.add_argument(
        "file",
        help="Chemin du fichier JSON à reformater"
    )
    file_arg.completer = FilesCompleter(("json",))

    output_arg = parser.add_argument(
        "-o", "--output",
        help="Fichier de sortie ; par défaut, crée un nouveau fichier à côté de l'original"
    )
    output_arg.completer = FilesCompleter()

    parser.add_argument(
        "--compact",
        action="store_true",
        help="Écrit le JSON en format compact"
    )

    return parser


def main():
    parser = build_parser()
    argcomplete.autocomplete(parser)
    args = parser.parse_args()

    input_path = Path(args.file)

    if not input_path.exists():
        raise FileNotFoundError(f"Fichier introuvable : {input_path}")

    with input_path.open("r", encoding="utf-8") as f:
        data = json.load(f)

    if args.output:
        output_path = Path(args.output)
    else:
        suffix = "_compact" if args.compact else "_pretty"
        output_path = input_path.with_name(f"{input_path.stem}{suffix}{input_path.suffix}")

    with output_path.open("w", encoding="utf-8") as f:
        if args.compact:
            json.dump(data, f, ensure_ascii=False, separators=(",", ":"))
        else:
            json.dump(data, f, ensure_ascii=False, indent=2)
            f.write("\n")

    print(f"Fichier écrit : {output_path}")


if __name__ == "__main__":
    main()
