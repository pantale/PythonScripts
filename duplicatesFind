#!/usr/bin/env python3
import sys
import os
import hashlib
from datetime import datetime
from collections import defaultdict
from multiprocessing import Pool, cpu_count
from tqdm import tqdm
from send2trash import send2trash


def getKbMbGb(val):
    if val > 1073741824:
        return str(int(100 * val / 1073741824) / 100) + ' Gb'
    if val > 1048576:
        return str(int(100 * val / 1048576) / 100) + ' Mb'
    return str(int(100 * val / 1024) / 100) + ' Kb'


def create_duplicates_by_size(lf, folder):
    """Construit lf: size -> [paths]."""
    fls = 0
    for foldername, subfolders, filenames in os.walk(folder):
        for filename in filenames:
            file_path = os.path.join(foldername, filename)
            try:
                file_path = os.path.realpath(file_path)
                file_size = os.path.getsize(file_path)
            except OSError:
                continue
            if file_size != 0:
                fls += 1
                lf.setdefault(file_size, []).append(file_path)
    return fls


def create_duplicates_by_fast_hash(df, df2):
    """Fast hash séquentiel (1 kio)."""
    for size, files in tqdm(df2.items(), desc='Fast hash', ncols=110, colour='#7f0000'):
        if len(files) > 1:
            for file in files:
                try:
                    with open(file, 'rb') as f:
                        file_hash = hashlib.md5(f.read(1024)).hexdigest()
                except OSError:
                    continue
                df.setdefault(file_hash, []).append(file)


# ---------- Workers multiprocessing ----------

def worker_fast_hash(file):
    """Retourne (hash_1k, file) ou (None, file)."""
    try:
        with open(file, 'rb') as f:
            file_hash = hashlib.md5(f.read(1024)).hexdigest()
    except OSError:
        return None, file
    return file_hash, file


def worker_full_hash(file):
    """Retourne (full_hash, file) ou (None, file)."""
    try:
        with open(file, 'rb') as f:
            file_hash = hashlib.md5(f.read()).hexdigest()
    except OSError:
        return None, file
    return file_hash, file


def create_duplicates_by_fast_hash_mp(df, df2, processes=None, chunksize=16):
    """Fast hash parallèle (1 kio)."""
    # Aplatir les listes de fichiers
    all_files = [f for files in df2.values() for f in files if len(files) > 1]
    n_files = len(all_files)
    if n_files == 0:
        return

    if processes is None:
        processes = max(1, cpu_count() - 1)

    print(f"Fast Hash (multiprocessing) on {n_files} files using {processes} processes")

    with Pool(processes=processes) as pool:
        for h, file in tqdm(
            pool.imap_unordered(worker_fast_hash, all_files, chunksize=chunksize),
            total=n_files,
            ncols=110,
            desc='Fast hash MP',
            colour='#7f0000',
        ):
            if h is None:
                continue
            df.setdefault(h, []).append(file)


def create_duplicates_by_hash_mp(df, df2, processes=None, chunksize=8):
    """Full hash parallèle (hash complet)."""
    all_files = [f for files in df2.values() for f in files if len(files) > 1]
    n_files = len(all_files)
    if n_files == 0:
        return

    if processes is None:
        processes = max(1, cpu_count() - 1)

    print(f"Full Hash (multiprocessing) on {n_files} files using {processes} processes")

    with Pool(processes=processes) as pool:
        for h, file in tqdm(
            pool.imap_unordered(worker_full_hash, all_files, chunksize=chunksize),
            total=n_files,
            ncols=110,
            desc='Full hash MP',
            colour='#7f0000',
        ):
            if h is None:
                continue
            df.setdefault(h, []).append(file)


# ---------- Version séquentielle d’origine du full hash ----------

def create_duplicates_by_hash(df, df2):
    """Full hash séquentiel (version d’origine)."""
    for size, files in tqdm(df2.items(), desc='Loading', ncols=110, colour='#7f0000'):
        if len(files) > 1:
            for file in files:
                try:
                    with open(file, 'rb') as f:
                        file_hash = hashlib.md5(f.read()).hexdigest()
                except OSError:
                    continue
                df.setdefault(file_hash, []).append(file)


def get_size_of_duplicates(duplicates):
    sz = 0
    for f, p in duplicates.items():
        try:
            sz += os.path.getsize(p[0]) * (len(p) - 1)
        except OSError:
            continue
    return sz


def list_of_duplicates(duplicates):
    for file_hash, paths in duplicates.items():
        if len(paths) > 1:
            print("-----------------------")
            for path in paths:
                print(path, ":", datetime.fromtimestamp(os.path.getmtime(path)))


def keep_recent_file(duplicates):
    for file_hash, paths in duplicates.items():
        if len(paths) > 1:
            file_dates = [(file, os.path.getmtime(file)) for file in paths]
            keep_file = max(file_dates, key=lambda x: x[1])
            for file in paths:
                if file != keep_file[0]:
                    try:
                        send2trash(file)
                        print(f"{file} was moved to trash")
                    except Exception:
                        continue


def keep_old_file(duplicates):
    for file_hash, paths in duplicates.items():
        if len(paths) > 1:
            file_dates = [(file, os.path.getmtime(file)) for file in paths]
            keep_file = min(file_dates, key=lambda x: x[1])
            for file in paths:
                if file != keep_file[0]:
                    try:
                        send2trash(file)
                        print(f"{file} was moved to trash")
                    except Exception:
                        continue


def removeSingle(fd):
    dd = {}
    for f, p in fd.items():
        if len(p) > 1:
            dd[f] = p
    return dd


# --------------------------------------------------------
# Start of the main program
# --------------------------------------------------------

def main():
    print("duplicatesFind (multiprocessing full hash)")
    print("(c) by Olivier Pantalé 2022-2026\n")

    if len(sys.argv) <= 1:
        print("Usage is the following:")
        print("    duplicateFind path [options]")
        print("Options:")
        print("    --print      displays the list of files")
        print("    --keepnew    deletes all but the most recent duplicate files")
        print("    --keepold    deletes all but the oldest duplicate files")
        print("    --mp         parallelize fast & full hash")
        print("    --mpfast     parallelize fast hash")
        print("    --mpfull     parallelize full hash (recommended)")
        print("    --proc N     use N processes")
        return

    folder = sys.argv[1]
    options = sys.argv[2:]

    # --mp active à la fois fast et full
    use_mp = "--mp" in options
    use_mp_fast = ("--mpfast" in options) or use_mp
    use_mp_full = ("--mpfull" in options) or use_mp
    processes = None
    if "--proc" in options:
        idx = options.index("--proc")
        try:
            processes = int(options[idx + 1])
        except (IndexError, ValueError):
            processes = None

    print("Scanning subdirectories for duplicate files")

    lf = {}
    print("Check duplicates using Sizes")
    nfiles = create_duplicates_by_size(lf, folder)
    file_sizes = removeSingle(lf)
    print(nfiles, "files scanned in directory:", folder)
    print(len(file_sizes), "potential duplicate candidates by size")

    lf = {}
    print("Check duplicates using Fast Hash")
    if use_mp_fast:
        create_duplicates_by_fast_hash_mp(lf, file_sizes, processes=processes, chunksize=16)
    else:
        create_duplicates_by_fast_hash(lf, file_sizes)
    duplicates_f = removeSingle(lf)
    print(len(duplicates_f), "potential duplicate candidates by fast hash")

    lf = {}
    print("Check duplicates using Full Hash")
    if use_mp_full:
        create_duplicates_by_hash_mp(lf, duplicates_f, processes=processes, chunksize=8)
    else:
        create_duplicates_by_hash(lf, duplicates_f)
    duplicates = removeSingle(lf)
    savedSize = get_size_of_duplicates(duplicates)
    print(
        '\n',
        len(duplicates),
        'real duplicate files found (' + getKbMbGb(savedSize) + ')'
    )

    if '--print' in options:
        list_of_duplicates(duplicates)
    if '--keepnew' in options:
        print("DELETING all but the most recent duplicate files")
        keep_recent_file(duplicates)
        print('deleted (' + getKbMbGb(savedSize) + ') of duplicate files')
    if '--keepold' in options:
        print("DELETING all but the oldest duplicate files")
        keep_old_file(duplicates)
        print('deleted (' + getKbMbGb(savedSize) + ') of duplicate files')


if __name__ == "__main__":
    main()

