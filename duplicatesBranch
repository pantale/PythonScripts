    import argcomplete
except ImportError:
    argcomplete = None  # argcomplete est optionnel

PROGRAM_NAME = "duplicatesBranch"
PROGRAM_COPYRIGHT = "(c) by Olivier Pantalé 2019-2026"

# ---------- Lecture de fichiers / hash ----------

def chunk_reader(fobj, chunk_size=1024):
    """Iterateur de blocs pour lire un fichier par morceaux."""
    while True:
        chunk = fobj.read(chunk_size)
        if not chunk:
            return
        yield chunk


def get_hash(filename, first_chunk_only=False, hash_func=hashlib.sha1):
    """Calcule le hash (SHA1 par défaut) d'un fichier.

    Si first_chunk_only est True, ne lit que les 1024 premiers octets.
    """
    hashobj = hash_func()
    try:
        with open(filename, "rb") as fobj:
            if first_chunk_only:
                hashobj.update(fobj.read(1024))
            else:
                for chunk in chunk_reader(fobj):
                    hashobj.update(chunk)
    except OSError:
        return None
    return hashobj.digest()


def create_hashes_by_size(path, recursive=True):
    """Retourne un dict {taille: [fichiers]} et le nombre de fichiers scannés."""
    hashes_by_size = defaultdict(list)
    number_of_files = 0

    if recursive:
        print(f"Building tree directory of: {path}")
    else:
        print(f"Seeking directory of: {path}")

    npaths = sum(1 for _ in os.walk(path)) if recursive else 1

    for dirpath, dirnames, filenames in tqdm(
        os.walk(path),
        total=npaths,
        desc="Loading",
        ncols=110,
        colour="#7f0000",
    ):
        for filename in filenames:
            full_path = os.path.join(dirpath, filename)
            try:
                full_path = os.path.realpath(full_path)
                file_size = os.path.getsize(full_path)
            except OSError:
                continue

            if file_size <= 0:
                continue

            number_of_files += 1
            hashes_by_size[file_size].append(full_path)

        if not recursive:
            break

    return hashes_by_size, number_of_files

# ---------- FAST HASH (séquentiel + MP) ----------

def create_hashes_by_fasthash(hashes_by_size):
    """Phase de fast hash (1 kio) séquentielle, à partir du regroupement par taille."""
    hashes_on_1k = defaultdict(list)
    total_sizes = len(hashes_by_size)

    for _, filenames in tqdm(
        hashes_by_size.items(),
        desc="Fast hash",
        total=total_sizes,
        ncols=110,
        colour="#7f0000",
    ):
        for filename in filenames:
            small_hash = get_hash(filename, first_chunk_only=True)
            if small_hash is None:
                continue
            hashes_on_1k[small_hash].append(filename)

    return hashes_on_1k


def worker_fast_hash(filename):
    """Worker multiprocessing pour le fast hash."""
    h = get_hash(filename, first_chunk_only=True)
    return h, filename


def create_hashes_by_fasthash_mp(hashes_by_size, processes, chunksize=16):
    """Phase de fast hash (1 kio) parallèle."""
    hashes_on_1k = defaultdict(list)
    all_files = [f for files in hashes_by_size.values() for f in files]
    n_files = len(all_files)
    if n_files == 0:
        return hashes_on_1k

    print(f"Fast Hash (multiprocessing) on {n_files} files using {processes} processes")

    with Pool(processes=processes) as pool:
        for h, filename in tqdm(
            pool.imap_unordered(worker_fast_hash, all_files, chunksize=chunksize),
            total=n_files,
            ncols=110,
            desc="Fast hash MP",
            colour="#7f0000",
        ):
            if h is None:
                continue
            hashes_on_1k[h].append(filename)

    return hashes_on_1k

# ---------- FULL HASH (séquentiel + MP) ----------

def create_hashes_by_fullhash(hashes_on_1k):
    """Phase de full hash séquentielle à partir des groupes de fast hash."""
    hashes_full = defaultdict(list)
    all_files = [f for files in hashes_on_1k.values() for f in files]
    n_files = len(all_files)
    if n_files == 0:
        return hashes_full

    for filename in tqdm(
        all_files,
        total=n_files,
        ncols=110,
        desc="Full hash",
        colour="#7f0000",
    ):
        full_hash = get_hash(filename, first_chunk_only=False)
        if full_hash is None:
            continue
        hashes_full[full_hash].append(filename)

    return hashes_full


def worker_full_hash(filename):
    """Worker multiprocessing pour le full hash."""
    h = get_hash(filename, first_chunk_only=False)
    return h, filename


def create_hashes_by_fullhash_mp(hashes_on_1k, processes, chunksize=8):
    """Phase de full hash parallèle."""
    hashes_full = defaultdict(list)
    all_files = [f for files in hashes_on_1k.values() for f in files]
    n_files = len(all_files)
    if n_files == 0:
        return hashes_full

    print(f"Full Hash (multiprocessing) on {n_files} files using {processes} processes")

    with Pool(processes=processes) as pool:
        for h, filename in tqdm(
            pool.imap_unordered(worker_full_hash, all_files, chunksize=chunksize),
            total=n_files,
            ncols=110,
            desc="Full hash MP",
            colour="#7f0000",
        ):
            if h is None:
                continue
            hashes_full[h].append(filename)

    return hashes_full

# ---------- Utilitaires ----------

def norm_relpath(root, path):
    """Chemin relatif normalisé (séparateur '/')."""
    rel = os.path.relpath(path, root)
    return rel.replace(os.sep, "/")


def popItems(hashes_1, hashes_2):
    """Réduction à l'intersection des clés des deux dictionnaires."""
    common_keys = hashes_1.keys() & hashes_2.keys()
    hashes_1_reduced = {k: hashes_1[k] for k in common_keys}
    hashes_2_reduced = {k: hashes_2[k] for k in common_keys}
    return hashes_1_reduced, hashes_2_reduced


def countItems(dictio):
    """Compte le nombre total de fichiers dans un dict {clé: [fichiers]}."""
    return sum(len(files) for files in dictio.values())


def list_of_duplicates(hashes_full2, hashes_full1):
    """Affiche les couples de doublons (delete_path <=> keep_path)."""
    for hsh, files in hashes_full2.items():
        ref = hashes_full1[hsh][0]
        for filename in files:
            print("file", ascii(filename), "<=>", ascii(ref))


def get_size_of_duplicates(hashes_full):
    """Calcule la taille totale des doublons."""
    totSize = 0
    for _, files in hashes_full.items():
        for filename in files:
            try:
                totSize += os.path.getsize(filename)
            except OSError:
                pass
    return totSize


def getKbMbGb(val):
    """Formate une taille en Kb / Mb / Gb."""
    if val > 1073741824:
        return f"{int(100 * val / 1073741824) / 100} Gb"
    if val > 1048576:
        return f"{int(100 * val / 1048576) / 100} Mb"
    return f"{int(100 * val / 1024) / 100} Kb"

# ---------- Suppression de fichiers ----------

def delete_list_of_duplicates_trash(hashes_full, dry_run=False):
    """Envoie les fichiers doublons à la corbeille (send2trash) ou dry-run,
    en affichant les erreurs éventuelles.
    """
    count = 0
    size = 0
    for _, files in hashes_full.items():
        for filename in files:
            if dry_run:
                print("DRY-RUN trash file:", filename)
                continue
            try:
                s = os.path.getsize(filename)
            except OSError:
                s = 0
            try:
                send2trash(filename)
                count += 1
                size += s
                # print("TRASHED:", filename)
            except Exception as e:
                print("ERROR trashing:", filename, "->", repr(e))
    if not dry_run:
        print(f"{count} files sent to trash ({getKbMbGb(size)})")


def delete_list_of_duplicates_rm(hashes_full, dry_run=False):
    """Supprime définitivement les fichiers doublons (os.remove) ou dry-run."""
    count = 0
    size = 0
    for _, files in hashes_full.items():
        for filename in files:
            if dry_run:
                print("DRY-RUN rm file:", filename)
                continue
            try:
                s = os.path.getsize(filename)
            except OSError:
                s = 0
            try:
                os.remove(filename)
                count += 1
                size += s
                # print("REMOVED:", filename)
            except Exception as e:
                print("ERROR removing:", filename, "->", repr(e))
    if not dry_run:
        print(f"{count} files permanently removed ({getKbMbGb(size)})")

# ---------- Suppression de répertoires vides (rmdir only) ----------

def remove_empty_dir(path, dry_run=False):
    """Remove a directory only if it is empty, using os.rmdir (no trash)."""
    try:
        # Vérifie que le répertoire est vide (pas de fichiers ni de sous-répertoires)
        if any(os.scandir(path)):
            return 0
    except FileNotFoundError:
        # Déjà supprimé / déplacé
        return 0
    except NotADirectoryError:
        # Juste au cas où on passerait un fichier ici
        return 0
    except PermissionError as e:
        print("PERMISSION ERROR scanning dir:", path, "->", repr(e))
        return 0

    if dry_run:
        print("DRY-RUN rmdir:", path)
        return 1

    try:
        os.rmdir(path)
        # print("REMOVED DIR:", path)
        return 1
    except OSError as e:
        print("ERROR removing dir:", path, "->", repr(e))
        return 0


def remove_empty_dirs(path, dry_run=False, filter_dirs=None):
    """
    Parcourt l'arborescence et supprime les sous-répertoires vides avec os.rmdir.
    Si filter_dirs n'est pas None, ne considère que les répertoires qui sont
    dans filter_dirs ou en dessous d'un répertoire de filter_dirs.
    """
    empty = 0
    for root, dirnames, _ in os.walk(path, topdown=False):
        for dirname in dirnames:
            full = os.path.realpath(os.path.join(root, dirname))

            if filter_dirs is not None:
                # Ne supprimer que si ce répertoire est dans une branche
                # ayant effectivement contenu des doublons
                if not any(full == d or full.startswith(d + os.sep) for d in filter_dirs):
                    continue

            empty += remove_empty_dir(full, dry_run=dry_run)

    return empty

# ---------- argparse + main ----------

def build_parser():
    parser = argparse.ArgumentParser(
        prog=PROGRAM_NAME,
        description="Find duplicate files between two trees, optionally delete them.",
    )

    parser.add_argument("keep_path", help="Directory to keep (reference tree)")
    parser.add_argument("delete_path", help="Directory where duplicates may be removed")

    parser.add_argument(
        "--print",
        dest="do_print",
        action="store_true",
        help="Display the list of duplicate files",
    )

    parser.add_argument(
        "--delete",
        dest="do_delete",
        action="store_true",
        help="Delete duplicate files in delete_path (send to trash)",
    )

    parser.add_argument(
        "--rm",
        dest="do_rm",
        action="store_true",
        help="Permanently remove duplicate files in delete_path (no trash)",
    )

    parser.add_argument(
        "--empty",
        dest="do_empty",
        action="store_true",
        help="Remove empty sub-directories in delete_path (permanent delete with os.rmdir)",
    )

    parser.add_argument(
        "--dry-run",
        dest="dry_run",
        action="store_true",
        help="Do not delete or trash anything, only show what would be removed",
    )

    parser.add_argument(
        "--nrk",
        dest="nrk",
        action="store_true",
        help="Non-recursive search for keep_path",
    )

    parser.add_argument(
        "--nrd",
        dest="nrd",
        action="store_true",
        help="Non-recursive search for delete_path",
    )

    parser.add_argument(
        "--mp",
        dest="mp",
        action="store_true",
        help="Parallelize fast & full hash",
    )

    parser.add_argument(
        "--mpfast",
        dest="mpfast",
        action="store_true",
        help="Parallelize fast hash",
    )

    parser.add_argument(
        "--mpfull",
        dest="mpfull",
        action="store_true",
        help="Parallelize full hash (recommended)",
    )

    parser.add_argument(
        "--proc",
        type=int,
        metavar="N",
        help="Number of processes to use (default: ncore-1)",
    )

    parser.add_argument(
        "--samePath",
        dest="same_path",
        action="store_true",
        help="Only match files with same relative subdirectory",
    )

    parser.add_argument(
        "--sameName",
        dest="same_name",
        action="store_true",
        help="Only match files with same filename",
    )

    return parser


def main():
    print(PROGRAM_NAME)
    print(PROGRAM_COPYRIGHT)
    print()

    parser = build_parser()
    if argcomplete is not None:
        argcomplete.autocomplete(parser)
    args = parser.parse_args()

    keep_path = os.path.realpath(args.keep_path)
    delete_path = os.path.realpath(args.delete_path)

    rpk = not args.nrk
    rpd = not args.nrd
    same_path = args.same_path
    same_name = args.same_name
    dry_run = args.dry_run

    # --mp active les deux
    use_mp = args.mp
    use_mp_fast = args.mpfast or use_mp
    use_mp_full = args.mpfull or use_mp

    processes = args.proc if args.proc and args.proc > 0 else max(1, cpu_count() - 1)

    hashes_by_size_p1 = {}
    hashes_by_size_p2 = {}
    hashes_on_1k_p1 = {}
    hashes_on_1k_p2 = {}
    hashes_full_p1 = {}
    hashes_full_p2 = {}

    # Phase taille
    hashes_by_size_p1, nfiles1 = create_hashes_by_size(keep_path, recursive=rpk)
    print(nfiles1, "files scanned in directory:", keep_path)

    hashes_by_size_p2, nfiles2 = create_hashes_by_size(delete_path, recursive=rpd)
    print(nfiles2, "files scanned in directory:", delete_path)

    # Réduction à l'intersection des tailles
    hashes_by_size_p1, hashes_by_size_p2 = popItems(hashes_by_size_p1, hashes_by_size_p2)

    # Fast hash
    print("Left Fast Hash")
    if use_mp_fast:
        hashes_on_1k_p1 = create_hashes_by_fasthash_mp(
            hashes_by_size_p1, processes=processes, chunksize=16
        )
    else:
        hashes_on_1k_p1 = create_hashes_by_fasthash(hashes_by_size_p1)

    print("Right Fast Hash")
    if use_mp_fast:
        hashes_on_1k_p2 = create_hashes_by_fasthash_mp(
            hashes_by_size_p2, processes=processes, chunksize=16
        )
    else:
        hashes_on_1k_p2 = create_hashes_by_fasthash(hashes_by_size_p2)

    hashes_on_1k_p1, hashes_on_1k_p2 = popItems(hashes_on_1k_p1, hashes_on_1k_p2)

    nbr = countItems(hashes_on_1k_p2)
    print("\n", nbr, "duplicated candidates after Fast Hash phase")

    # Full hash
    print("Left Full Hash")
    if use_mp_full:
        hashes_full_p1 = create_hashes_by_fullhash_mp(
            hashes_on_1k_p1, processes=processes, chunksize=16
        )
    else:
        hashes_full_p1 = create_hashes_by_fullhash(hashes_on_1k_p1)

    print("\nRight Full Hash")
    if use_mp_full:
        hashes_full_p2 = create_hashes_by_fullhash_mp(
            hashes_on_1k_p2, processes=processes, chunksize=16
        )
    else:
        hashes_full_p2 = create_hashes_by_fullhash(hashes_on_1k_p2)

    hashes_full_p1, hashes_full_p2 = popItems(hashes_full_p1, hashes_full_p2)

    # Filtrage final selon samePath / sameName
    if same_path or same_name:
        hashes_full_p2_filtered = {}

        for hsh, files2 in hashes_full_p2.items():
            files1 = hashes_full_p1.get(hsh, [])
            if not files1:
                continue

            dirs1 = set()
            names1 = set()

            if same_path:
                dirs1 = {
                    os.path.dirname(norm_relpath(keep_path, f1))
                    for f1 in files1
                }

            if same_name:
                names1 = {basename(f1) for f1 in files1}

            filtered_files2 = []
            for f2 in files2:
                rel2 = norm_relpath(delete_path, f2)
                dir2 = os.path.dirname(rel2)
                name2 = basename(f2)

                ok = True
                if same_path and dir2 not in dirs1:
                    ok = False
                if same_name and name2 not in names1:
                    ok = False

                if ok:
                    filtered_files2.append(f2)

            if filtered_files2:
                hashes_full_p2_filtered[hsh] = filtered_files2

        hashes_full_p2 = hashes_full_p2_filtered

    nbr = countItems(hashes_full_p2)
    print("\n", nbr, "duplicates found (" + getKbMbGb(get_size_of_duplicates(hashes_full_p2)) + ")")

    if args.do_print:
        list_of_duplicates(hashes_full_p2, hashes_full_p1)

    # Construire l'ensemble des répertoires ayant contenu des doublons dans delete_path
    candidate_dirs = set()
    for files in hashes_full_p2.values():
        for filename in files:
            candidate_dirs.add(os.path.dirname(os.path.realpath(filename)))

    # Suppression des fichiers (trash ou rm)
    if args.do_delete or args.do_rm:
        if args.do_delete and args.do_rm:
            print("WARNING: both --delete and --rm specified, using --rm (permanent delete)")

        if dry_run:
            if args.do_rm:
                print("DELETING FILES PERMANENTLY (dry-run, nothing will be removed)")
            else:
                print("DELETING FILES (to trash, dry-run, nothing will be removed)")
        else:
            if args.do_rm:
                print("DELETING FILES PERMANENTLY (no trash)")
            else:
                print("DELETING FILES (to trash)")

        if args.do_rm:
            delete_list_of_duplicates_rm(hashes_full_p2, dry_run=dry_run)
        else:
            delete_list_of_duplicates_trash(hashes_full_p2, dry_run=dry_run)

    # Suppression des répertoires vides (rmdir only)
    if args.do_empty:
        if dry_run:
            print("REMOVING EMPTY DIRECTORIES (dry-run, nothing will be removed)")
        else:
            print("REMOVING EMPTY DIRECTORIES (permanent delete with os.rmdir)")
        empty = remove_empty_dirs(delete_path, dry_run=dry_run, filter_dirs=candidate_dirs)
        empty += remove_empty_dir(delete_path, dry_run=dry_run)
        if empty > 1:
            print(empty, "directories removed")
        else:
            print(empty, "directory removed")


if __name__ == "__main__":
    main()
