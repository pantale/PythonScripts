if (len(sys.argv) > mandatoryArgs):
    filename = sys.argv[1]
    color = sys.argv[2]
    # newstring = sys.argv[3]
    # filenames = glob.glob(pattern)
    if (len(sys.argv) > mandatoryArgs+1):
        if '--backup' in sys.argv[mandatoryArgs+1:]:
            BackupFile(filename)
            
    filedata = readFile(filename)
    start = filedata.find('\n\\begin{document}') + 18
    end = filedata.find('\n\\end{document}') +1
    startTxt = filedata[0:start]
    centerTxt = filedata[start:end]
    endTxt = filedata[end:]
    centerTxt = removeTextColor(centerTxt, color)
    writeFile(filename, startTxt+centerTxt+endTxt)
else:
    print ("Usage is the following:")
    print ("    removeLatexColor filename color [options]")
    print ("Options:")
    print ("    --backup :   backup the original file")
